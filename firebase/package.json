{
  "name": "campussync-firebase",
  "private": true,
  "type": "module",
  "description": "Firestore security rules and their emulator tests",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-campussync \"node --test test/rules.test.js\"",
    "emulators": "firebase emulators:start --only auth,firestore --project campussync-780a5",
    "seed": "node seed/seed.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@google-cloud/firestore": "^9.3.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.33.0"
  }
}
