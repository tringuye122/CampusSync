rules_version = '2';

// CampusSync Firestore security rules.
//
// Phase 7 covers accounts only: users/{uid} and handles/{handle}. Everything
// else is denied by default; invites, schedules, friends and clubs get their
// rules in the sync phase. Test with: cd firebase && npm test
//
// Every rule starts from isVerifiedStudent(): a signed-in account whose email is
// verified and ends in @unc.edu. The app checks this too, but the client is never trusted.

service cloud.firestore {
  match /databases/{database}/documents {

    function isVerifiedStudent() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@unc[.]edu');
    }

    function validHandle(h) {
      return h is string && h.matches('[a-z0-9_]{3,20}');
    }

    function validDisplayName(n) {
      return n is string && n.size() >= 2 && n.size() <= 40;
    }

    // Public profile. No email is stored here: any verified student can read it
    // (needed to search by handle), so it holds only a name and a handle.
    match /users/{uid} {
      allow read: if isVerifiedStudent();

      // Created together with the handle claim in one batch, and only for yourself.
      allow create: if isVerifiedStudent()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'handle', 'createdAt'])
        && validDisplayName(request.resource.data.displayName)
        && validHandle(request.resource.data.handle)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid;

      // The name can change. The handle and creation time cannot.
      allow update: if isVerifiedStudent()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'handle', 'createdAt'])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.handle == resource.data.handle
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // Handle -> owner. Create-only, which is what keeps handles unique: a second
    // create of the same id becomes an update, and updates are denied.
    match /handles/{handle} {
      allow read: if isVerifiedStudent();

      allow create: if isVerifiedStudent()
        && validHandle(handle)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle == handle;

      allow update, delete: if false;
    }

    // Deny everything not listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
